-- FN2: Get available beds in a ward
CREATE FUNCTION fn_AvailableBeds(p_ward_id INT)
RETURNS INT READS SQL DATA
BEGIN
    DECLARE v_avail INT;
    SELECT (total_beds - occupied) INTO v_avail
    FROM Ward WHERE ward_id = p_ward_id;
    RETURN COALESCE(v_avail, -1);
END $$

