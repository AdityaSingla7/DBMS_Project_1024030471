DELIMITER $$

-- SP1: Register a new patient
CREATE PROCEDURE sp_RegisterPatient(
    IN p_name      VARCHAR(100),
    IN p_dob       DATE,
    IN p_gender    ENUM('Male','Female','Other'),
    IN p_phone     VARCHAR(15),
    IN p_address   TEXT,
    IN p_blood_grp VARCHAR(5)
)
BEGIN
    INSERT INTO Patient (name, dob, gender, phone, address, blood_group)
    VALUES (p_name, p_dob, p_gender, p_phone, p_address, p_blood_grp);
    SELECT LAST_INSERT_ID() AS new_patient_id, 'Patient registered successfully' AS message;
END $$

-- SP2: Schedule an appointment
CREATE PROCEDURE sp_ScheduleAppointment(
    IN p_patient_id INT,
    IN p_doctor_id  INT,
    IN p_appt_date  DATETIME
)
BEGIN
    DECLARE v_count INT;
    SELECT COUNT(*) INTO v_count
    FROM Appointment
    WHERE doctor_id = p_doctor_id AND appt_date = p_appt_date AND status = 'Scheduled';

    IF v_count > 0 THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Doctor already has an appointment at this time.';
    ELSE
        INSERT INTO Appointment (patient_id, doctor_id, appt_date, status)
        VALUES (p_patient_id, p_doctor_id, p_appt_date, 'Scheduled');
        SELECT LAST_INSERT_ID() AS appt_id, 'Appointment scheduled' AS message;
    END IF;
END $$

-- SP3: Generate Bill for a patient (consultation + lab tests + medicines)
CREATE PROCEDURE sp_GenerateBill(IN p_patient_id INT)
BEGIN
    DECLARE v_lab_total      DECIMAL(10,2) DEFAULT 0;
    DECLARE v_medicine_total DECIMAL(10,2) DEFAULT 0;
    DECLARE v_consultation   DECIMAL(10,2) DEFAULT 500.00;
    DECLARE v_total          DECIMAL(10,2);

    SELECT COALESCE(SUM(test_fee), 0) INTO v_lab_total
    FROM Lab_Test WHERE patient_id = p_patient_id;

    SELECT COALESCE(SUM(PR.days * M.price), 0) INTO v_medicine_total
    FROM Prescription PR
    JOIN Medicine M ON PR.medicine_id = M.medicine_id
    WHERE PR.patient_id = p_patient_id;

    SET v_total = v_consultation + v_lab_total + v_medicine_total;

    INSERT INTO Bill (patient_id, total_amount, paid_amount, payment_status)
    VALUES (p_patient_id, v_total, 0, 'Unpaid');

    SELECT v_consultation AS consultation_fee,
           v_lab_total    AS lab_fees,
           v_medicine_total AS medicine_cost,
           v_total        AS grand_total,
           LAST_INSERT_ID() AS bill_id;
END $$

DELIMITER ;

