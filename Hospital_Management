DELIMITER $$

-- Cursor 1: Print all doctors and their department names
CREATE PROCEDURE sp_DoctorDeptReport()
BEGIN
    DECLARE done        INT DEFAULT 0;
    DECLARE v_doc_name  VARCHAR(100);
    DECLARE v_dept_name VARCHAR(100);
    DECLARE v_spec      VARCHAR(100);

    DECLARE cur_doctors CURSOR FOR
        SELECT D.name, Dept.dept_name, D.specialization
        FROM Doctor D JOIN Department Dept ON D.dept_id = Dept.dept_id;

    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = 1;

    CREATE TEMPORARY TABLE IF NOT EXISTS tmp_DoctorReport (
        doctor_name    VARCHAR(100),
        department     VARCHAR(100),
        specialization VARCHAR(100)
    );

    OPEN cur_doctors;
    read_loop: LOOP
        FETCH cur_doctors INTO v_doc_name, v_dept_name, v_spec;
        IF done THEN LEAVE read_loop; END IF;
        INSERT INTO tmp_DoctorReport VALUES (v_doc_name, v_dept_name, v_spec);
    END LOOP;
    CLOSE cur_doctors;

    SELECT * FROM tmp_DoctorReport;
    DROP TEMPORARY TABLE tmp_DoctorReport;
END $$


-- Cursor 2: List all unpaid bills with patient names
CREATE PROCEDURE sp_UnpaidBillsReport()
BEGIN
    DECLARE done       INT DEFAULT 0;
    DECLARE v_pat_name VARCHAR(100);
    DECLARE v_total    DECIMAL(10,2);
    DECLARE v_bill_id  INT;

    DECLARE cur_unpaid CURSOR FOR
        SELECT P.name, B.bill_id, B.total_amount
        FROM Bill B JOIN Patient P ON B.patient_id = P.patient_id
        WHERE B.payment_status IN ('Unpaid','Partial');

    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = 1;

    CREATE TEMPORARY TABLE IF NOT EXISTS tmp_UnpaidBills (
        patient_name VARCHAR(100),
        bill_id      INT,
        amount_due   DECIMAL(10,2)
    );

    OPEN cur_unpaid;
    bill_loop: LOOP
        FETCH cur_unpaid INTO v_pat_name, v_bill_id, v_total;
        IF done THEN LEAVE bill_loop; END IF;
        INSERT INTO tmp_UnpaidBills VALUES (v_pat_name, v_bill_id, v_total);
    END LOOP;
    CLOSE cur_unpaid;

    SELECT * FROM tmp_UnpaidBills;
    DROP TEMPORARY TABLE tmp_UnpaidBills;
END $$

DELIMITER ;

