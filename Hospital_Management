RETURNS DECIMAL(10,2) READS SQL DATA
BEGIN
    DECLARE v_total DECIMAL(10,2);
    SELECT COALESCE(SUM(total_amount), 0) INTO v_total
    FROM Bill WHERE patient_id = p_patient_id;
    RETURN v_total;
END $$

