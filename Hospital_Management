--  SECTION 3: SELECT QUERIES
-- ============================================================

-- Q1: List all patients with their blood group
SELECT patient_id, name, gender, blood_group, phone FROM Patient;

-- Q2: INNER JOIN – Appointments with patient & doctor names
SELECT
    A.appt_id,
    P.name  AS patient_name,
    D.name  AS doctor_name,
    A.appt_date,
    A.status
FROM Appointment A
JOIN Patient P ON A.patient_id = P.patient_id
JOIN Doctor  D ON A.doctor_id  = D.doctor_id
ORDER BY A.appt_date;

-- Q3: LEFT JOIN – All patients and their bills
SELECT
    P.patient_id,
    P.name,
    COALESCE(B.total_amount, 0)         AS total_billed,
    COALESCE(B.payment_status,'No Bill') AS payment_status
FROM Patient P
LEFT JOIN Bill B ON P.patient_id = B.patient_id;

-- Q4: Aggregate – Revenue by payment status
SELECT
    payment_status,
    COUNT(*)                        AS num_bills,
    SUM(total_amount)               AS total_billed,
    SUM(paid_amount)                AS total_collected,
    SUM(total_amount - paid_amount) AS pending
FROM Bill
GROUP BY payment_status;

-- Q5: GROUP BY + HAVING – Doctors with more than 1 prescription
SELECT
    D.name   AS doctor_name,
    COUNT(*) AS total_prescriptions
FROM Prescription PR
JOIN Doctor D ON PR.doctor_id = D.doctor_id
GROUP BY D.name
HAVING COUNT(*) > 1;

-- Q6: Subquery – Patients never admitted
SELECT name, phone FROM Patient
WHERE patient_id NOT IN (SELECT patient_id FROM Admission);

-- Q7: Subquery – Medicines above average price
SELECT name, category, price FROM Medicine
WHERE price > (SELECT AVG(price) FROM Medicine)
ORDER BY price DESC;

-- Q8: Ward occupancy report
SELECT
    ward_name,
    ward_type,
    total_beds,
    occupied,
    (total_beds - occupied)              AS available_beds,
    ROUND((occupied/total_beds)*100, 1)  AS occupancy_pct
FROM Ward;

-- Q9: Doctor salary report per department
SELECT
    Dept.dept_name,
    COUNT(D.doctor_id) AS num_doctors,
    AVG(D.salary)      AS avg_salary,
    MAX(D.salary)      AS max_salary
FROM Doctor D
JOIN Department Dept ON D.dept_id = Dept.dept_id
GROUP BY Dept.dept_name;

-- Q10: Full prescription details (3-table join)
SELECT
    PR.prescription_id,
    P.name          AS patient,
    D.name          AS prescribed_by,
    M.name          AS medicine,
    PR.dosage,
    PR.days,
    (PR.days * M.price) AS est_medicine_cost
FROM Prescription PR
JOIN Patient  P ON PR.patient_id  = P.patient_id
JOIN Doctor   D ON PR.doctor_id   = D.doctor_id
JOIN Medicine M ON PR.medicine_id = M.medicine_id;

-- Q11: VIEW – Admitted patients summary
CREATE OR REPLACE VIEW v_CurrentAdmissions AS
SELECT
    P.name    AS patient_name,
    W.ward_name,
    W.ward_type,
    A.bed_no,
    A.admit_date,
    A.reason
FROM Admission A
JOIN Patient P ON A.patient_id = P.patient_id
JOIN Ward    W ON A.ward_id    = W.ward_id
WHERE A.discharge_date IS NULL;

SELECT * FROM v_CurrentAdmissions;

-- Q12: VIEW – Doctor-wise appointment count
CREATE OR REPLACE VIEW v_DoctorAppointments AS
SELECT
    D.name            AS doctor_name,
    Dept.dept_name,
    COUNT(A.appt_id)  AS total_appointments,
    SUM(A.status = 'Completed') AS completed,
    SUM(A.status = 'Scheduled') AS scheduled,
    SUM(A.status = 'Cancelled') AS cancelled
FROM Doctor D
JOIN Department Dept ON D.dept_id    = Dept.dept_id
LEFT JOIN Appointment A ON D.doctor_id = A.doctor_id
GROUP BY D.name, Dept.dept_name;

SELECT * FROM v_DoctorAppointments;


