DELIMITER $$


-- TR1: After Prescription insert → reduce medicine stock
CREATE TRIGGER trg_ReduceStock
AFTER INSERT ON Prescription
FOR EACH ROW
BEGIN
    UPDATE Medicine SET stock_qty = stock_qty - NEW.days
    WHERE medicine_id = NEW.medicine_id;
END $$

-- TR2: Alert if medicine stock falls below 50 (log to a table)
CREATE TABLE IF NOT EXISTS StockAlert (
    alert_id      INT AUTO_INCREMENT PRIMARY KEY,
    medicine_id   INT,
    medicine_name VARCHAR(100),
    stock_qty     INT,
    alert_time    DATETIME DEFAULT CURRENT_TIMESTAMP
) $$


CREATE TRIGGER trg_StockAlert
AFTER UPDATE ON Medicine
FOR EACH ROW
BEGIN
    IF NEW.stock_qty < 50 THEN
        INSERT INTO StockAlert (medicine_id, medicine_name, stock_qty)
        VALUES (NEW.medicine_id, NEW.name, NEW.stock_qty);
    END IF;
END $$


-- TR3: After Admission insert → increment ward occupied count
CREATE TRIGGER trg_IncrementOccupied
AFTER INSERT ON Admission
FOR EACH ROW
BEGIN
    UPDATE Ward SET occupied = occupied + 1 WHERE ward_id = NEW.ward_id;
END $$

-- TR4: After Admission update (discharge) → decrement occupied count
CREATE TRIGGER trg_DecrementOccupied
AFTER UPDATE ON Admission
FOR EACH ROW
BEGIN
    IF OLD.discharge_date IS NULL AND NEW.discharge_date IS NOT NULL THEN
        UPDATE Ward SET occupied = occupied - 1 WHERE ward_id = NEW.ward_id;
    END IF;
END $$

DELIMITER ;


